# Copia este archivo a `.env` y ajústalo a tu entorno.
# La app (web + API) corre en el mismo servidor local.

# Web bajo prueba (el servidor que Playwright levanta con webServer).
WEB_BASE_URL=http://localhost:3000

# API bajo prueba (mismo servidor local, sin el prefijo /api).
API_BASE_URL=http://localhost:3000

# Token de API (opcional; no se usa en local).
API_TOKEN=

# Etiqueta de entorno (local | staging | prod).
TEST_ENV=local
